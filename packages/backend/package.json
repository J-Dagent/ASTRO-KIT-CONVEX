{
  "name": "@repo/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/_generated/api": "./convex/_generated/api.ts",
    "./convex/_generated/dataModel": "./convex/_generated/dataModel.ts"
  },
  "scripts": {
    "setup": "node scripts/assert-cloud-config.mjs && convex dev --once && node scripts/sync-app-env.mjs",
    "sync:app-env": "node scripts/sync-app-env.mjs",
    "dev": "node scripts/assert-cloud-config.mjs && convex dev",
    "deploy": "node scripts/assert-cloud-config.mjs && convex deploy",
    "codegen": "node scripts/assert-cloud-config.mjs && convex codegen",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.13.0",
    "@convex-dev/polar": "0.9.2",
    "@polar-sh/checkout": "0.4.1",
    "@polar-sh/sdk": "0.49.0",
    "better-auth": "1.7.20",
    "convex": "1.49.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "^22.18.12",
    "convex-test": "0.0.69",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "^4.1.12"
  }
}
